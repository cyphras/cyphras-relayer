NODE_ENV=development
PORT=8080

# In Docker this is overridden to point at the postgres service.
DATABASE_URL=postgres://relayer:relayer@localhost:5432/relayer

STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Testnet throwaway secret of the relayer wallet. Never commit a funded mainnet secret.
RELAYER_SECRET=

# Factory contract the relayer discovers pools from.
FACTORY_ID=

# Indexer starts here when a pool has no stored cursor; set to the factory deploy ledger so no
# commit history is missed. A value before the RPC retention window (INDEXER_MAX_WINDOW behind the
# latest ledger) is rejected, because leaves there can no longer be fetched and the tree would be
# incomplete; re-index from pool creation instead.
INDEXER_START_LEDGER=0
INDEXER_MAX_WINDOW=100000
INDEXER_POLL_INTERVAL_MS=5000

# Baseline gas for the full ephemeral reveal flow (sponsor + reveal + merge), in stroops. Refined
# by the cost observed from real reveals when available. Margin is basis points (2000 = 20%). The
# quote is rounded up to FEE_TIER_STROOPS so many users share one fee value (anti-fingerprint).
REVEAL_FLOW_FEE_STROOPS=120000
FEE_MARGIN_BPS=2000
FEE_TIER_STROOPS=100000
FEE_FALLBACK_INCLUSION_STROOPS=200
FEE_QUOTE_TTL_SECONDS=120
# How many recent confirmed reveals feed the observed-cost average behind the quote.
FEE_SAMPLE_SIZE=50

# Channel accounts that source the create-ephemeral transaction so reveals run in parallel. Each is
# derived from RELAYER_SECRET and funded from the relayer wallet on boot, in stroops.
CHANNEL_COUNT=8
CHANNEL_FUND_STROOPS=30000000
CHANNEL_MIN_BALANCE_STROOPS=20000000

# Maintenance loop: keeper extends contract instance TTL before archival, monitor tops up channels
# and warns when the master wallet is low. All actions are master-sourced so they run serially.
MAINTENANCE_INTERVAL_MS=300000
KEEPER_EXTEND_LEDGERS=500000
KEEPER_THRESHOLD_LEDGERS=100000
MASTER_MIN_BALANCE_STROOPS=500000000

# Terminal reveal jobs are deleted after this many hours so the recipient and timing are not
# retained longer than needed.
JOB_RETENTION_HOURS=168

# API limits: per-client request rate, max body size, and per-request timeout.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT_BYTES=16384
REQUEST_TIMEOUT_MS=30000
# Trusted reverse-proxy hops. 0 = bound directly (do not trust X-Forwarded-For). Set to the number
# of proxies in front so the rate limit keys on the real client IP.
TRUST_PROXY_HOPS=0

# Optional webhook posted on critical fund-safety and data-integrity alerts. Logged regardless.
ALERT_WEBHOOK_URL=

LOG_LEVEL=info
